# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# The test suite never sends real mail (MessageRoutingAgent is always mocked or
# given a fake AI provider), but a real smtp://mailhog DSN here can still get
# touched during kernel shutdown/reboot between tests and hang trying to
# connect to a host that doesn't exist outside the e2e docker-compose stack.
MAILER_DSN=null://null
